rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    // Bootstrapped Admin: exclusively ollohberdiinfo@gmail.com with verified Google email
    function isAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'ollohberdiinfo@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function parentUserExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) ||
        existsAfter(/databases/$(database)/documents/users/$(userId));
    }

    // Validation Blueprint: UserProfile (/users/{userId})
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['userId', 'displayName', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt']) &&
        data.userId == userId &&
        data.userId == request.auth.uid &&
        isValidId(data.userId) &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 120 &&
        (!('email' in data) || (data.email is string && data.email.size() >= 3 && data.email.size() <= 160)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: NotebookWord (/users/{userId}/notebook/{wordId})
    function isValidNotebookWord(data, userId, wordId) {
      return data.keys().hasAll([
          'wordId',
          'userId',
          'word',
          'phonetic',
          'partOfSpeech',
          'definition',
          'cefrLevel',
          'exampleSentence',
          'collocations',
          'savedAt',
          'reviewInterval',
          'repetitions',
          'nextReviewDate',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'wordId',
          'userId',
          'word',
          'phonetic',
          'partOfSpeech',
          'definition',
          'cefrLevel',
          'exampleSentence',
          'collocations',
          'savedAt',
          'reviewInterval',
          'repetitions',
          'nextReviewDate',
          'createdAt',
          'updatedAt'
        ]) &&
        data.wordId == wordId &&
        isValidId(data.wordId) &&
        data.userId == userId &&
        data.userId == request.auth.uid &&
        isValidId(data.userId) &&
        data.word is string && data.word.size() >= 1 && data.word.size() <= 100 &&
        data.phonetic is string && data.phonetic.size() >= 1 && data.phonetic.size() <= 120 &&
        data.partOfSpeech is string && data.partOfSpeech.size() >= 1 && data.partOfSpeech.size() <= 40 &&
        data.definition is string && data.definition.size() >= 1 && data.definition.size() <= 600 &&
        (data.cefrLevel == 'B1' || data.cefrLevel == 'B2' || data.cefrLevel == 'C1') &&
        data.exampleSentence is string && data.exampleSentence.size() >= 1 && data.exampleSentence.size() <= 600 &&
        data.collocations is list && data.collocations.size() <= 10 &&
        (data.collocations.size() == 0 || (data.collocations[0] is string && data.collocations[0].size() <= 120)) &&
        data.savedAt is number && data.savedAt >= 0 &&
        data.reviewInterval is number && data.reviewInterval >= 0 && data.reviewInterval <= 3650 &&
        data.repetitions is number && data.repetitions >= 0 && data.repetitions <= 1000 &&
        data.nextReviewDate is number && data.nextReviewDate >= 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: LearnedWord (/users/{userId}/learned/{wordId})
    function isValidLearnedWord(data, userId, wordId) {
      return data.keys().hasAll(['wordId', 'userId', 'cefrLevel', 'createdAt']) &&
        data.keys().hasOnly(['wordId', 'userId', 'cefrLevel', 'createdAt']) &&
        data.wordId == wordId &&
        isValidId(data.wordId) &&
        data.userId == userId &&
        data.userId == request.auth.uid &&
        isValidId(data.userId) &&
        (data.cefrLevel == 'B1' || data.cefrLevel == 'B2' || data.cefrLevel == 'C1') &&
        data.createdAt is timestamp;
    }

    // Validation Blueprint: StudentSubscription (/subscriptions/{emailKey})
    function isValidStudentSubscription(data, emailKey) {
      return data.keys().hasAll([
          'emailKey',
          'studentEmail',
          'studentName',
          'proUntil',
          'planLabel',
          'updatedByEmail',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'emailKey',
          'studentEmail',
          'studentName',
          'proUntil',
          'planLabel',
          'updatedByEmail',
          'createdAt',
          'updatedAt'
        ]) &&
        data.emailKey == emailKey &&
        isValidId(data.emailKey) &&
        data.studentEmail is string && data.studentEmail.size() >= 3 && data.studentEmail.size() <= 160 &&
        data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 120 &&
        data.proUntil is number && data.proUntil >= 0 &&
        data.planLabel is string && data.planLabel.size() >= 1 && data.planLabel.size() <= 60 &&
        data.updatedByEmail is string && data.updatedByEmail == request.auth.token.email && data.updatedByEmail.size() <= 160 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: SubscriptionSettings (/settings/{settingId})
    function isValidSubscriptionSettings(data, settingId) {
      return data.keys().hasAll([
          'settingId',
          'monthlyPriceText',
          'telegramUsername',
          'paymentInstructions',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'settingId',
          'monthlyPriceText',
          'telegramUsername',
          'paymentInstructions',
          'updatedAt'
        ]) &&
        data.settingId == settingId &&
        isValidId(data.settingId) &&
        data.monthlyPriceText is string && data.monthlyPriceText.size() >= 1 && data.monthlyPriceText.size() <= 80 &&
        data.telegramUsername is string && data.telegramUsername.size() >= 1 && data.telegramUsername.size() <= 80 &&
        data.paymentInstructions is string && data.paymentInstructions.size() >= 1 && data.paymentInstructions.size() <= 500 &&
        data.updatedAt is timestamp;
    }

    // Collection: /users/{userId}
    match /users/{userId} {
      allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId);
      allow list: if isAdmin();

      allow create: if isVerifiedOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt']);

      allow delete: if false;

      // Subcollection: /users/{userId}/notebook/{wordId}
      match /notebook/{wordId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(wordId);
        allow list: if isOwner(userId);

        allow create: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(wordId) &&
          isValidNotebookWord(incoming(), userId, wordId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          parentUserExists(userId);

        allow update: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(wordId) &&
          isValidNotebookWord(incoming(), userId, wordId) &&
          incoming().userId == existing().userId &&
          incoming().wordId == existing().wordId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'definition',
            'reviewInterval',
            'repetitions',
            'nextReviewDate',
            'updatedAt'
          ]) &&
          parentUserExists(userId);

        allow delete: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(wordId) &&
          existing().userId == request.auth.uid &&
          parentUserExists(userId);
      }

      // Subcollection: /users/{userId}/learned/{wordId}
      match /learned/{wordId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(wordId);
        allow list: if isOwner(userId);

        allow create: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(wordId) &&
          isValidLearnedWord(incoming(), userId, wordId) &&
          incoming().createdAt == request.time &&
          parentUserExists(userId);

        allow update: if false;

        allow delete: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(wordId) &&
          existing().userId == request.auth.uid &&
          parentUserExists(userId);
      }
    }

    // Collection: /subscriptions/{emailKey}
    match /subscriptions/{emailKey} {
      allow get: if isValidId(emailKey) && (
        isAdmin() ||
        (isVerifiedUser() && (
          resource == null ||
          existing().studentEmail == request.auth.token.email ||
          emailKey == 'uid-' + request.auth.uid
        ))
      );
      allow list: if isAdmin();

      allow create: if isAdmin() &&
        isValidId(emailKey) &&
        isValidStudentSubscription(incoming(), emailKey) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidId(emailKey) &&
        isValidStudentSubscription(incoming(), emailKey) &&
        incoming().emailKey == existing().emailKey &&
        incoming().studentEmail == existing().studentEmail &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'studentName',
          'proUntil',
          'planLabel',
          'updatedByEmail',
          'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(emailKey);
    }

    // Collection: /settings/{settingId}
    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if false;

      allow create: if isAdmin() &&
        isValidId(settingId) &&
        isValidSubscriptionSettings(incoming(), settingId) &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidId(settingId) &&
        isValidSubscriptionSettings(incoming(), settingId) &&
        incoming().settingId == existing().settingId &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'monthlyPriceText',
          'telegramUsername',
          'paymentInstructions',
          'updatedAt'
        ]);

      allow delete: if false;
    }
  }
}
